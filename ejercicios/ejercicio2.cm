/* Constantes graficas de jBACI y configuracion del buffer */
const
	int RED = 1; int BLACK = 2; int BLUE = 3; int YELLOW = 4;
	int GREEN = 5; int MAGENTA = 6; int WHITE = 7;

	int CIRCLE = 1;
	int LINE = 2;
	int RECTANGLE = 3;
	int TRIANGLE = 4;
	int ANIMAGE = 5;
	int RNDRECT = 6;
	int LINE_CIRCLE = 21;
	int LINE_RECTANGLE = 22;
	int LINE_TRIANGLE = 23;
	int LINE_RNDRECT = 24;
	int NUMBER_BOX = 25;

	int N = 5;
	int TOTAL_ITEMS = 10;

/* Semaforos */
semaphore mutex;
semaphore huecos;
semaphore productos;

/* Variables compartidas */
int buffer[5];
int entrada;
int salida;
int ocupados;

/* Dibuja los 5 huecos del buffer y dos circulos para Productor y Consumidor */
void inicializar_graficos() {
	int i;
	for (i = 0; i < N; i = i + 1) {
		create(i, RECTANGLE, RED, 40 + i * 80, 140, 60, 60);
	}
	create(10, CIRCLE, YELLOW, 120, 50, 45, 45);
	create(11, CIRCLE, YELLOW, 260, 50, 45, 45);
}

/* Muestra tambien el estado por consola */
void dibujar_interfaz(int es_productor, int valor) {
	int i;
	if (es_productor == 1) {
		cout << ">> PRODUCTOR inserto: " << valor << endl;
	} else {
		cout << "<< CONSUMIDOR extrajo: " << valor << endl;
	}

	cout << "ESTADO DEL BUFFER: ";
	for (i = 0; i < N; i = i + 1) {
		if (buffer[i] == -1) {
			cout << "[ -- ]";
		} else {
			cout << "[ " << buffer[i] << " ]";
		}
	}
	cout << " (" << ocupados << "/" << N << " ocupados)" << endl;
}

int producir(int num) {
	int k;
	int pausa;
	pausa = 0;
	for (k = 0; k < 80; k = k + 1) {
		pausa = pausa + 1;
	}
	return num;
}

void anadir_buffer(int item) {
	buffer[entrada] = item;
	changecolor(entrada, GREEN);
	changecolor(10, BLUE);
	changecolor(11, YELLOW);
	entrada = (entrada + 1) % N;
	ocupados = ocupados + 1;
	dibujar_interfaz(1, item);
}

int coger_buffer() {
	int extraido;
	extraido = buffer[salida];
	buffer[salida] = -1;
	changecolor(salida, RED);
	changecolor(10, YELLOW);
	changecolor(11, BLUE);
	salida = (salida + 1) % N;
	ocupados = ocupados - 1;
	dibujar_interfaz(0, extraido);
	return extraido;
}

void consumir(int valor) {
	int k;
	int pausa;
	pausa = valor;
	for (k = 0; k < 180; k = k + 1) {
		pausa = pausa + 1;
	}
}

void productor() {
	int item;
	int dato;
	item = 1;
	while (item <= TOTAL_ITEMS) {
		dato = producir(item);
		wait(huecos);
		wait(mutex);
		anadir_buffer(dato);
		signal(mutex);
		signal(productos);
		item = item + 1;
	}
}

void consumidor() {
	int extraido;
	int veces;
	veces = 1;
	while (veces <= TOTAL_ITEMS) {
		wait(productos);
		wait(mutex);
		extraido = coger_buffer();
		signal(mutex);
		signal(huecos);
		consumir(extraido);
		veces = veces + 1;
	}
}

void main() {
	int i;

	entrada = 0;
	salida = 0;
	ocupados = 0;

	for (i = 0; i < N; i = i + 1) {
		buffer[i] = -1;
	}

	initialsem(mutex, 1);
	initialsem(huecos, N);
	initialsem(productos, 0);

	inicializar_graficos();

	cobegin {
		productor();
		consumidor();
	}
}
