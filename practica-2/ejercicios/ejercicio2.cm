/* Constantes graficas de jBACI y configuracion del buffer */
const
	int RED = 1; int BLACK = 2; int BLUE = 3; int YELLOW = 4;
	int GREEN = 5; int MAGENTA = 6; int WHITE = 7;

	int CIRCLE = 1;
	int RECTANGLE = 3;
	int TRIANGLE = 4;
	int LINE_RECTANGLE = 22;

const int N = 5;
const int TOTAL_ITEMS = 10;

/* Semaforos */
semaphore mutex;
semaphore huecos;
semaphore productos;

/* Variables compartidas */
int buffer[N];
int entrada;
int salida;
int ocupados;

void iniciar_variables() {
	int i;
	entrada = 0;
	salida = 0;
	ocupados = 0;

	for (i = 0; i < N; i = i + 1) {
		buffer[i] = -1;
	}

	initialsem(mutex, 1);
	initialsem(huecos, N);
	initialsem(productos, 0);
}

/* DIBUJO INICIAL DE COMPONENTES */
void dibujar_buffer() {
	int i;
	create(20, LINE_RECTANGLE, BLACK, 25, 165, 410, 90);
	for (i = 0; i < N; i = i + 1) {
		create(i, RECTANGLE, RED, 40 + i * 80, 180, 60, 60);
		create(30 + i, CIRCLE, BLACK, 58 + i * 80, 198, 24, 24);
		makevisible(30 + i, 0);
	}
}

void dibujar_productor() {
	create(10, TRIANGLE, WHITE, 102, 70, 66, 56);
}

void dibujar_consumidor() {
	create(11, CIRCLE, WHITE, 295, 68, 60, 60);
}

void iniciar_graficos() {
	dibujar_buffer();
	dibujar_productor();
	dibujar_consumidor();
}

/* ACTUALIZACION VISUAL DE ESTADOS E INTERFAZ */
void dibujar_interfaz(int es_productor, int valor) {
	int i;
	if (es_productor == 1) {
		cout << "Productor inserta " << valor << " | Buffer: ";
	} else {
		cout << "Consumidor extrae " << valor << " | Buffer: ";
	}

	for (i = 0; i < N; i = i + 1) {
		if (buffer[i] == -1) {
			cout << "- ";
		} else {
			cout << buffer[i] << " ";
		}
	}
	cout << "(" << ocupados << "/" << N << ")" << endl;
}

/* FUNCION AUXILIAR PARA LA INTERFAZ */
void retardo(int ciclos) {
	int k;
	int temp;
	temp = 0;
	for (k = 0; k < ciclos; k = k + 1) {
		temp = temp + 1;
	}
}

/* TAREAS DEL PRODUCTOR */
int producir(int num) {
	retardo(40);
	return num;
}

void anadir_buffer(int item) {
	/* Entra en la seccion critica */
	changecolor(10, BLUE);
	changecolor(20, BLUE);

	buffer[entrada] = item;
	changecolor(entrada, GREEN);
	makevisible(30 + entrada, 1);
	entrada = (entrada + 1) % N;
	ocupados = ocupados + 1;
	dibujar_interfaz(1, item);
	retardo(50);

	/* Sale de la seccion critica antes de soltar mutex */
	changecolor(20, BLACK);
	changecolor(10, WHITE);
}

void productor() {
	int item;
	int dato;
	item = 1;
	while (item <= TOTAL_ITEMS) {
		changecolor(10, MAGENTA);
		dato = producir(item);

		changecolor(10, YELLOW);
		wait(huecos);
		wait(mutex);

		anadir_buffer(dato);

		signal(mutex);
		signal(productos);

		item = item + 1;
	}
}

/* TAREAS DEL CONSUMIDOR */
void consumir(int valor) {
	retardo(125);
}

int coger_buffer() {
	int extraido;

	/* Entra en la seccion critica */
	changecolor(11, BLUE);
	changecolor(20, BLUE);

	extraido = buffer[salida];
	buffer[salida] = -1;
	makevisible(30 + salida, 0);
	changecolor(salida, RED);
	salida = (salida + 1) % N;
	ocupados = ocupados - 1;
	dibujar_interfaz(0, extraido);
	retardo(50);

	/* Sale de la seccion critica antes de soltar mutex */
	changecolor(20, BLACK);
	changecolor(11, WHITE);

	return extraido;
}

void consumidor() {
	int extraido;
	int veces;
	veces = 1;
	while (veces <= TOTAL_ITEMS) {
		changecolor(11, YELLOW);
		wait(productos);
		wait(mutex);

		extraido = coger_buffer();

		signal(mutex);
		signal(huecos);

		changecolor(11, MAGENTA);
		consumir(extraido);
		changecolor(11, WHITE);

		veces = veces + 1;
	}
}

void main() {
	iniciar_variables();
	iniciar_graficos();

	cobegin {
		productor();
		consumidor();
	}
}
